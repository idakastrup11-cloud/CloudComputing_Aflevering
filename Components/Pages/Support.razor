@page "/support"
@rendermode InteractiveServer
@using SupportWebApp.Models
@using SupportWebApp.Services
@inject CosmosDbService CosmosDbService

<PageTitle>Support</PageTitle>

<h1>Support</h1>

<p>Opret en supporthenvendelse</p>

<EditForm Model="@supportMessage"
          OnSubmit="@SubmitMessage"
          FormName="supportForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Category</label>
        <InputText class="form-control" @bind-Value="supportMessage.Category" />
    </div>

    <div class="mb-3">
        <label>Customer</label>
        <InputText class="form-control" @bind-Value="supportMessage.Customer" />
    </div>

    <div class="mb-3">
        <label>Subject</label>
        <InputText class="form-control" @bind-Value="supportMessage.Subject" />
    </div>

    <button type="submit" class="btn btn-primary">
        Send
    </button>
</EditForm>

@if (submitted)
{
    <p class="mt-3">Supporthenvendelsen er oprettet!</p>
}

@code {
    private SupportMessage supportMessage = new();
    private bool submitted = false;

    private async Task SubmitMessage()
    {
        await CosmosDbService.CreateSupportMessageAsync(supportMessage);
        submitted = true;
    }
}

